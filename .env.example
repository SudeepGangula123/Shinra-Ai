# Telegram tipline (token from @BotFather). Leave empty to run the web app only.
TELEGRAM_BOT_TOKEN=

# Where the database and uploaded files live
DATA_DIR=data

# Hosted engines (leave empty to run the engines inside this app at /engines/*)
# ENGINE_CLAIM_URL=https://example.com/engines/claim
# ENGINE_MEDIA_URL=
# ENGINE_ORIGIN_URL=
# ENGINE_VERDICT_URL=

# Limits (defaults shown)
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=20
# MAX_AUDIO_MB=20
# CHECK_TIMEOUT=150
# RATE_LIMIT_PER_WINDOW=30
